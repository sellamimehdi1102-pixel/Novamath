{
  "name": "novamath-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Pipeline de build, lint et tests du frontend NovaMath (webapp/static/).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:curricula": "python webapp/curriculum_registry.py",
    "build": "npm run validate:curricula && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint webapp/static/js",
    "lint:fix": "eslint webapp/static/js --fix",
    "format": "prettier --write \"webapp/static/js/**/*.js\" \"webapp/static/**/*.html\" \"webapp/static/css/**/*.css\"",
    "format:check": "prettier --check \"webapp/static/js/**/*.js\" \"webapp/static/**/*.html\" \"webapp/static/css/**/*.css\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.9",
    "axe-core": "^4.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
