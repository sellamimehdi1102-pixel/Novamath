# Stripe Billing (webapp/stripe_service.py) — copier en .env et remplir avec
# les vraies valeurs. Ne jamais committer .env (voir .gitignore).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_PRICE_PREMIUM=price_1TttEqGX38XgmLh8wepnFE6F
STRIPE_PRICE_ULTRA=price_1TttH8GX38XgmLh8fo0bOjsu
# Secret de signature du endpoint webhook (Dashboard Stripe > Developers >
# Webhooks > votre endpoint > "Signing secret"), nécessaire pour /api/checkout/webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Tests End-to-End Stripe (webapp/tests/test_stripe_e2e.py) ──────────────
# Réutilisent EXACTEMENT les 5 variables Stripe ci-dessus — aucune variable
# supplémentaire. Cette suite exécute de VRAIS appels réseau vers Stripe
# Test Mode (jamais de mock) et se désactive automatiquement (skip, jamais
# une erreur) si l'une d'elles est absente ou n'est qu'un placeholder.
# Sécurité : REFUSE catégoriquement de s'exécuter avec une clé sk_live_,
# quelle que soit la configuration — voir webapp/tests/stripe_e2e_helpers.py.
#
# Pour l'activer en local :
#   1. Utiliser les clés Test Mode de https://dashboard.stripe.com/test/apikeys
#      (STRIPE_SECRET_KEY doit commencer par sk_test_).
#   2. Créer 2 Price ID Test Mode (Premium/Ultra) et les renseigner ci-dessus.
#   3. Obtenir un STRIPE_WEBHOOK_SECRET réel avec la Stripe CLI (aucun
#      webhook réellement livré par HTTP dans cette suite — voir
#      DEPLOYMENT.md — mais la clé doit être valide pour signer/vérifier les
#      événements de test construits par la suite) :
#        stripe listen --print-secret
#   4. Lancer : python -m pytest webapp/tests/test_stripe_e2e.py

# Environnement Flask (webapp/config.py) : "development" (défaut) ou
# "production". En production : debug désactivé, cookies de session/CSRF
# marqués Secure (nécessite HTTPS), lancement via `gunicorn webapp.server:app`.
FLASK_ENV=development

# Base de données (webapp/database_service.py) — ARCH-02. Absente/vide :
# SQLite (fichier local data/novamath.db) — comportement historique
# inchangé, rien d'autre à installer en développement. Positionnée avec un
# schéma postgres(ql):// : PostgreSQL, détecté automatiquement, sans aucun
# changement de code. Format :
#   postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE
# Avec docker-compose.yml (profil "postgres") : postgresql://novamath:novamath@db:5432/novamath
# DATABASE_URL=

# Pool de connexions PostgreSQL (psycopg_pool) — sans effet en SQLite.
# Nombre de connexions maintenues en permanence.
# DATABASE_POOL_SIZE=5
# Connexions supplémentaires autorisées en pic (taille max = POOL_SIZE + MAX_OVERFLOW).
# DATABASE_MAX_OVERFLOW=10
# Secondes d'attente max pour obtenir une connexion avant erreur.
# DATABASE_POOL_TIMEOUT=30
# Durée de vie max (s) d'une connexion avant recyclage.
# DATABASE_POOL_RECYCLE=3600

# Identifiants du service "db" de docker-compose.yml (profil "postgres")
# uniquement — sans effet ailleurs, à synchroniser avec DATABASE_URL ci-dessus
# si utilisés (voir DEPLOYMENT.md, section PostgreSQL).
# POSTGRES_DB=novamath
# POSTGRES_USER=novamath
# POSTGRES_PASSWORD=change-me

# Surcharges individuelles optionnelles (sinon dérivées de FLASK_ENV ci-dessus) :
# FLASK_DEBUG=true
# SESSION_COOKIE_SECURE=true
# REMEMBER_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax
# RATE_LIMIT_ENABLED=true

# OAuth Google (webapp/auth.py::OAUTH_PROVIDERS) — architecture prête pour
# Google en premier, Microsoft/Apple/GitHub par extension du même mécanisme.
# Absentes : /api/auth/google/start renvoie 501, le reste du site fonctionne
# normalement (même philosophie que STRIPE_SECRET_KEY). Obtenues depuis
# https://console.cloud.google.com/apis/credentials (identifiants OAuth 2.0,
# type "Application Web", URI de redirection autorisé :
# https://votre-domaine/api/auth/google/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Rôles d'équipe (webapp/role_service.py) — SEC-05. Emails séparés par des
# virgules : tout compte local qui se connecte (register/login) avec l'un de
# ces emails est automatiquement promu Role.ADMIN (accès aux routes internes,
# ex: /api/dev/dashboard). Laisser vide en local si aucun compte admin n'est
# nécessaire.
# NOVAMATH_ADMIN_EMAILS=admin@example.com,autre-admin@example.com

# Supervision / observabilité (webapp/logging_service.py, backup_service.py).

# Niveau de log standard du module logging Python. Défaut INFO.
# LOG_LEVEL=INFO

# DSN Sentry (https://sentry.io) — laisser vide/absent pour ne rien activer :
# le système fonctionne normalement sans Sentry configuré (voir
# logging_service.configure_sentry()).
# SENTRY_DSN=

# Dossier de sauvegarde (webapp/backup_service.py), créé automatiquement.
# Défaut : backups/ à la racine du projet.
# BACKUP_DIRECTORY=backups

# Nombre de jours de rétention des sauvegardes (les plus anciennes sont
# supprimées automatiquement — voir backup_service._apply_retention). Défaut 30.
# BACKUP_RETENTION_DAYS=30

# Authentification à deux facteurs / TOTP (webapp/two_factor_service.py) —
# SEC-03. Absente : la 2FA reste indisponible (501), le reste du site
# fonctionne normalement (même philosophie que STRIPE_SECRET_KEY/SENTRY_DSN).
# Clé Fernet (cryptography.fernet) qui chiffre le secret TOTP stocké en base
# (jamais en clair) — générer UNE FOIS avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne jamais faire tourner cette clé sans avoir sauvegardé les secrets déjà
# chiffrés : une clé perdue rend tous les comptes 2FA existants irrécupérables
# (ils devront désactiver/réactiver la 2FA).
TWO_FACTOR_SECRET_KEY=

# Nom affiché par l'application d'authentification (Google Authenticator,
# Microsoft Authenticator, Authy, 1Password, Bitwarden...) à côté du compte.
TWO_FACTOR_ISSUER=NovaMath

# En-têtes de sécurité HTTP (webapp/security_headers_service.py) — SEC-06.
# Coupure d'urgence globale (CSP, HSTS, X-Frame-Options, Referrer-Policy,
# Permissions-Policy, Cross-Origin-Opener-Policy, Cross-Origin-Resource-
# Policy...) : actif par défaut, à ne désactiver qu'en diagnostic ponctuel.
# ENABLE_SECURITY_HEADERS=true

# Bascule la CSP en mode observation (Content-Security-Policy-Report-Only) :
# journalise les violations dans la console du navigateur sans jamais rien
# bloquer — utile pour valider une nouvelle règle avant de l'appliquer.
# CSP_REPORT_ONLY=false

# HSTS (Strict-Transport-Security) : n'est JAMAIS envoyée hors production ni
# hors HTTPS, quelle que soit cette valeur. Active par défaut en production.
# ENABLE_HSTS=true

# Durée en secondes de la directive HSTS (défaut 31536000 = 1 an, valeur
# recommandée par hstspreload.org — la directive `preload` n'est ajoutée que
# si cette durée est atteinte).
# HSTS_MAX_AGE=31536000

# Sources CSP additionnelles (connect-src/img-src/font-src), séparées par des
# espaces — vide par défaut : aucun domaine externe requis aujourd'hui en
# dehors du CDN KaTeX (rendu des formules mathématiques, autorisé par défaut
# dans security_headers_service.py). À utiliser si un futur besoin apparaît
# (ex : Sentry browser SDK, avatar hébergé ailleurs) sans modifier de code.
# CSP_ALLOWED_CONNECT=
# CSP_ALLOWED_IMAGES=
# CSP_ALLOWED_FONTS=

# Envoi d'email (webapp/email_service.py) — SEC-04. Absentes : aucun email
# n'est réellement envoyé (le lien de consentement parental est renvoyé en
# clair dans la réponse JSON en mode développement, même philosophie que
# STRIPE_SECRET_KEY/TWO_FACTOR_SECRET_KEY) — à configurer avec un vrai
# fournisseur SMTP pour que NovaMath soit exploitable commercialement.
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_USE_TLS=true
# EMAIL_FROM_ADDRESS=no-reply@novamath.fr
# EMAIL_FROM_NAME=NovaMath

# URL absolue du site, utilisée uniquement pour construire les liens
# cliquables envoyés dans les emails (ex : lien de consentement parental).
# DOIT être positionnée avec le vrai domaine en production.
# APP_BASE_URL=http://localhost:5000

# Consentement parental RGPD (webapp/consent_service.py) — SEC-04. Durée de
# validité (jours) du lien envoyé au parent avant expiration. Défaut 30.
# PARENTAL_CONSENT_TOKEN_TTL_DAYS=30

# Déploiement / Gunicorn (gunicorn.conf.py, racine du projet) — ARCH-03/05.
# Voir DEPLOYMENT.md pour le détail de chaque plateforme (Docker, VPS,
# Railway, Render, Fly.io, Coolify, Azure App Service, Cloud Run).

# Port d'écoute — injecté automatiquement par la plupart des PaaS (Railway,
# Render, Fly.io, Cloud Run) : ne pas définir manuellement sur ces
# plateformes. Défaut 8000 (Docker Compose/VPS/exécution locale de l'image).
# PORT=8000

# Nombre de processus workers Gunicorn (convention 12-factor). Défaut :
# 2×CPU+1, plafonné à 4 — voir gunicorn.conf.py pour le détail.
# WEB_CONCURRENCY=4

# Threads par worker (worker "gthread"). Défaut 2.
# GUNICORN_THREADS=2
# GUNICORN_WORKER_CLASS=gthread

# Timeouts Gunicorn en secondes — voir gunicorn.conf.py pour la justification
# de chaque valeur par défaut.
# GUNICORN_TIMEOUT=60
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=5

# Recyclage des workers (filet de sécurité anti-fuite mémoire).
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100

# Logging Gunicorn (toujours stdout/stderr par défaut, "-") et charge unique
# de l'application avant le fork des workers (voir gunicorn.conf.py).
# GUNICORN_LOGLEVEL=info
# GUNICORN_ACCESSLOG=-
# GUNICORN_ERRORLOG=-
# GUNICORN_PRELOAD_APP=true
