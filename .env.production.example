# ============================================================================
# Mathadap — variables d'environnement de PRODUCTION (Render)
#
# Modèle uniquement : AUCUNE vraie valeur ici. Copier les noms dans le
# tableau "Environment" du Web Service Render (jamais dans un fichier commité
# dans Git — voir .gitignore, qui exclut déjà .env.* sauf .env.example).
#
# Deux tags utilisés dans les commentaires :
#   [RENDER]      -> à définir dans Render (Environment), valeur différente
#                     du .env local ou absente en local.
#   [LOCAL=RENDER] -> même valeur/format qu'en local, juste à re-saisir.
#   [OPTIONNEL]    -> laisser vide/absent si la fonctionnalité n'est pas
#                     utilisée (comportement de repli documenté dans
#                     .env.example, jamais une erreur au démarrage).
# ============================================================================

# ── Cœur Flask ──────────────────────────────────────────────────────────
# [RENDER] Doit valoir "production" (jamais "development") : active cookies
# Secure, désactive le debug, active HSTS/TRUST_PROXY_HEADERS par défaut.
FLASK_ENV=production

# ── Base de données ─────────────────────────────────────────────────────
# [RENDER] NE PAS DÉFINIR. Laisser DATABASE_URL absente => SQLite par défaut
# (data/novamath.db). Ne jamais utiliser un schéma sqlite:/// ici :
# backup_service.py ignore cette variable et continue de lire le chemin par
# défaut (voir audit pré-production) — la définir romprait les sauvegardes
# sans erreur visible.
# DATABASE_URL=

# ── Persistance SQLite (disque persistant Render) ───────────────────────
# [RENDER] Nécessite un disque persistant Render monté sur /app/data (voir
# RENDER_SETUP.md, étape 6). Redirige aussi les sauvegardes À L'INTÉRIEUR du
# même disque persistant que la base — sans ce réglage, backups/ resterait
# sur le système de fichiers éphémère du conteneur et serait perdu à chaque
# redéploiement/redémarrage. Aucun changement de code nécessaire
# (config.py::BACKUP_DIRECTORY lit déjà cette variable).
BACKUP_DIRECTORY=/app/data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_AUTO_ENABLED=true
BACKUP_AUTO_HOUR_UTC=3

# ── Stripe (LIVE) ────────────────────────────────────────────────────────
# [RENDER] Clés LIVE réelles (jamais les clés Test Mode utilisées en local
# pour webapp/tests/test_stripe_e2e.py). Ne jamais coller ces valeurs dans
# un fichier suivi par Git — uniquement dans Render > Environment.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_PRICE_PREMIUM=price_xxx
STRIPE_PRICE_ULTRA=price_xxx
# Signing secret du endpoint webhook LIVE (Stripe Dashboard > Developers >
# Webhooks > endpoint https://VOTRE-DOMAINE/api/checkout/webhook > "Signing
# secret") — différent du secret Test Mode utilisé en local.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Reverse proxy / URLs absolues ────────────────────────────────────────
# [RENDER] Domaine final réel, HTTPS, sans slash final — utilisé pour les
# liens absolus dans les emails (consentement parental, etc.). À mettre à
# jour si le domaine change.
APP_BASE_URL=https://votre-domaine.fr
# [RENDER] Explicite bien qu'actif par défaut en production (config.py) :
# indispensable pour que success_url/cancel_url Stripe et request.is_secure
# soient corrects derrière le reverse proxy TLS de Render.
TRUST_PROXY_HEADERS=true

# ── Cookies / sécurité session (dérivés de FLASK_ENV=production, listés
# ici pour audit — ne pas surcharger sauf besoin explicite) ───────────────
# SESSION_COOKIE_SECURE=true
# REMEMBER_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax
# RATE_LIMIT_ENABLED=true
# ENABLE_SECURITY_HEADERS=true
# ENABLE_HSTS=true

# ── Email transactionnel (Resend SMTP) ───────────────────────────────────
# [RENDER] Host/port fournis par Resend (SMTP relay). Voir RENDER_SETUP.md
# pour la checklist DNS (SPF/DKIM) associée au domaine.
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=resend
EMAIL_SMTP_PASSWORD=re_xxx
EMAIL_SMTP_USE_TLS=true
# Doit utiliser le domaine final vérifié dans Resend (jamais une adresse
# gmail/outlook générique : rejetée ou marquée spam par la plupart des
# fournisseurs).
EMAIL_FROM_ADDRESS=no-reply@votre-domaine.fr
EMAIL_FROM_NAME=Mathadap

# ── 2FA (optionnel) ──────────────────────────────────────────────────────
# [OPTIONNEL] Générer UNE FOIS avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne jamais régénérer après activation par de vrais comptes (secrets 2FA
# existants deviendraient irrécupérables).
TWO_FACTOR_SECRET_KEY=
TWO_FACTOR_ISSUER=Mathadap

# ── OAuth Google (optionnel) ──────────────────────────────────────────────
# [OPTIONNEL] Absentes : /api/auth/google/start renvoie 501, reste du site
# inchangé. URI de redirection à autoriser dans Google Cloud Console :
# https://votre-domaine.fr/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Rôles d'équipe (optionnel) ────────────────────────────────────────────
# [RENDER] À renseigner avec vos vrais emails admin si besoin d'accès /admin.
# NOVAMATH_ADMIN_EMAILS=
# NOVAMATH_SUPER_ADMIN_EMAILS=

# ── Supervision (optionnel) ───────────────────────────────────────────────
# [OPTIONNEL] Vide = pas de Sentry, comportement normal sans erreur.
# SENTRY_DSN=
LOG_LEVEL=INFO

# ── Chatbot IA (optionnel) ────────────────────────────────────────────────
# [OPTIONNEL] Absentes : fournisseur "fake" (moteur local), aucun coût API.
# CHATBOT_PROVIDER=
# GEMINI_API_KEY=

# ── Gunicorn (optionnel, valeurs par défaut déjà adaptées — voir
# gunicorn.conf.py) — ne définir que pour un besoin précis constaté.
# WEB_CONCURRENCY=4
# GUNICORN_THREADS=2

# ── Port ──────────────────────────────────────────────────────────────────
# [RENDER] NE PAS DÉFINIR : Render injecte automatiquement $PORT, lu par
# gunicorn.conf.py (bind = 0.0.0.0:$PORT).
# PORT=
