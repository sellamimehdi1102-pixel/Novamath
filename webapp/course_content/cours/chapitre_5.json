      "id": "milieu-et-norme",
      "title": "Milieu et distance",
      "intro": "Dans cette leçon, tu vas apprendre à calculer un milieu et une distance avec des coordonnées.",
      "objectif": "À la fin de ce cours, tu sauras calculer les coordonnées d'un milieu et la longueur d'un segment.",
      "definition": "Le milieu d'un segment se calcule en faisant la moyenne des coordonnées. La distance entre deux points se calcule avec une formule proche du théorème de Pythagore.",
      "reglesImportantes": [
        "Milieu $I$ de $[AB]$ : $I\\left(\\dfrac{x_A+x_B}{2}\\,;\\dfrac{y_A+y_B}{2}\\right)$",
        "Distance : $AB = \\sqrt{(x_B-x_A)^2+(y_B-y_A)^2}$",
        "Cette formule marche seulement dans un repère bien carré (orthonormé)."
      ],
      "methode": {
        "titre": "Comment calculer une distance",
        "etapes": [
          {
            "icone": "sliders",
            "couleur": "blue",
            "texte": "Calcule les coordonnées du vecteur entre les deux points."
          },
          {
            "icone": "target",
            "couleur": "purple",
            "texte": "Mets chaque coordonnée au carré, puis additionne."
          },
          {
            "icone": "check",
            "couleur": "green",
            "texte": "Prends la racine carrée du résultat."
          }
        ],
        "etapesParNiveau": {
          "normal": [
            {
              "icone": "sliders",
              "couleur": "blue",
              "texte": "Calcule les coordonnées du vecteur entre les deux points."
            },
            {
              "icone": "target",
              "couleur": "purple",
              "texte": "Mets chaque coordonnée au carré, puis additionne."
            },
            {
              "icone": "check",
              "couleur": "green",
              "texte": "Prends la racine carrée du résultat."
            }
          ],
          "debutant": [],
          "rapide": []
        }
      },
      "exemples": [
        {
          "titre": "Exemple 1",
          "enonce": "$A(1\\,;2)$, $B(4\\,;6)$. Calcule $AB$.",
          "calcul": [
            {
              "expr": "\\vec{AB}(3\\,;4)",
              "texte": "On calcule les coordonnées du vecteur."
            },
            {
              "expr": "AB = \\sqrt{3^2+4^2}",
              "texte": "On applique la formule."
            },
            {
              "expr": "AB = \\sqrt{25} = 5",
              "texte": "On calcule la racine carrée."
            }
          ],
          "reponse": "$AB = 5$",
          "id": "milieu-et-norme-exemple-1",
          "difficulte": "moyen"
        }
      ],
      "erreursFrequentes": [
        "Oublier de mettre les coordonnées au carré avant d'additionner.",
        "Oublier la racine carrée à la fin du calcul."
      ],
      "astuce": "Si tu retrouves un résultat qui ressemble à 3-4-5 ou 6-8-10, c'est souvent un triangle rectangle bien connu.",
      "aRetenir": [
        "Milieu : moyenne des coordonnées",
        "$AB=\\sqrt{(x_B-x_A)^2+(y_B-y_A)^2}$"
      ],
      "figure": {
