    {
      "id": "condition-de-colinearite-repere",
      "title": "Colinéarité avec des coordonnées",
      "intro": "Dans cette leçon, tu vas apprendre à vérifier une colinéarité par le calcul.",
      "objectif": "À la fin de ce cours, tu sauras utiliser un calcul pour prouver un alignement.",
      "definition": "Deux vecteurs $\\vec{u}(x\\,;y)$ et $\\vec{v}(x'\\,;y')$ sont colinéaires quand $x \\times y' - x' \\times y = 0$.",
      "reglesImportantes": [
        "Ce calcul s'appelle un déterminant.",
        "Si le déterminant vaut 0, les vecteurs sont colinéaires.",
        "Ça sert à prouver un alignement ou un parallélisme."
      ],
      "methode": {
        "titre": "Comment prouver un alignement avec des coordonnées",
        "etapes": [
          {
            "icone": "sliders",
            "couleur": "blue",
            "texte": "Calcule les coordonnées de deux vecteurs formés par les points."
          },
          {
            "icone": "target",
            "couleur": "purple",
            "texte": "Calcule le déterminant $xy'-x'y$."
          },
          {
            "icone": "check",
            "couleur": "green",
            "texte": "Si le résultat est 0, les points sont alignés."
          }
        ],
        "etapesParNiveau": {
          "normal": [
            {
              "icone": "sliders",
              "couleur": "blue",
              "texte": "Calcule les coordonnées de deux vecteurs formés par les points."
            },
            {
              "icone": "target",
              "couleur": "purple",
              "texte": "Calcule le déterminant $xy'-x'y$."
            },
            {
              "icone": "check",
              "couleur": "green",
              "texte": "Si le résultat est 0, les points sont alignés."
            }
          ],
          "debutant": [],
          "rapide": []
        }
      },
      "exemples": [
        {
          "titre": "Exemple 1",
          "enonce": "$A(0\\,;0)$, $B(2\\,;4)$, $C(3\\,;6)$ sont-ils alignés ?",
          "calcul": [
            {
              "expr": "\\vec{AB}(2\\,;4) \\text{ et } \\vec{AC}(3\\,;6)",
              "texte": "On calcule les deux vecteurs."
            },
            {
              "expr": "2\\times 6 - 3\\times 4 = 0",
              "texte": "On calcule le déterminant."
            }
          ],
          "reponse": "Le déterminant vaut 0 : les points sont alignés",
          "id": "condition-de-colinearite-repere-exemple-1",
          "difficulte": "moyen"
        }
      ],
      "erreursFrequentes": [
        "Se tromper dans l'ordre de la soustraction du déterminant.",
        "Oublier de calculer les coordonnées des vecteurs avant le déterminant."
      ],
      "astuce": "Ce même calcul sert aussi à vérifier si deux droites sont parallèles.",
      "aRetenir": [
