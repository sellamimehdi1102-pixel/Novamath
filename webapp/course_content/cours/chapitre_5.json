    {
      "id": "base-repere-et-coordonnees",
      "title": "Le repère et les coordonnées",
      "intro": "Dans cette leçon, tu vas apprendre à repérer un point avec des coordonnées.",
      "objectif": "À la fin de ce cours, tu sauras calculer les coordonnées d'un vecteur.",
      "definition": "Un repère permet de donner à chaque point du plan deux nombres : ses coordonnées $(x\\,;y)$.",
      "reglesImportantes": [
        "Un point $A$ a des coordonnées $(x_A\\,;y_A)$.",
        "Un vecteur $\\vec{AB}$ a pour coordonnées $(x_B - x_A\\,;\\,y_B - y_A)$.",
        "On calcule toujours \"arrivée moins départ\"."
      ],
      "methode": {
        "titre": "Comment calculer les coordonnées d'un vecteur",
        "etapes": [
          {
            "icone": "target",
            "couleur": "blue",
            "texte": "Repère les coordonnées du point de départ et du point d'arrivée."
          },
          {
            "icone": "sliders",
            "couleur": "purple",
            "texte": "Soustrais : arrivée moins départ, pour $x$ puis pour $y$."
          },
          {
            "icone": "check",
            "couleur": "green",
            "texte": "Écris le résultat sous forme $(x\\,;y)$."
          }
        ],
        "etapesParNiveau": {
          "normal": [
            {
              "icone": "target",
              "couleur": "blue",
              "texte": "Repère les coordonnées du point de départ et du point d'arrivée."
            },
            {
              "icone": "sliders",
              "couleur": "purple",
              "texte": "Soustrais : arrivée moins départ, pour $x$ puis pour $y$."
            },
            {
              "icone": "check",
              "couleur": "green",
              "texte": "Écris le résultat sous forme $(x\\,;y)$."
            }
          ],
          "debutant": [],
          "rapide": []
        }
      },
      "exemples": [
        {
          "titre": "Exemple 1",
          "enonce": "$A(2\\,;-1)$ et $B(5\\,;3)$. Calcule les coordonnées de $\\vec{AB}$.",
          "calcul": [
            {
              "expr": "x = 5 - 2 = 3",
              "texte": "Coordonnée x : arrivée moins départ."
            },
            {
              "expr": "y = 3 - (-1) = 4",
              "texte": "Coordonnée y : arrivée moins départ."
            }
          ],
          "reponse": "$\\vec{AB}(3\\,;4)$",
          "id": "base-repere-et-coordonnees-exemple-1",
          "difficulte": "moyen"
        }
      ],
      "erreursFrequentes": [
        "Calculer \"départ moins arrivée\" au lieu de \"arrivée moins départ\".",
        "Oublier le signe négatif d'une coordonnée."
      ],
      "astuce": "Retiens : toujours \"la fin moins le début\", comme pour calculer une différence de température.",
      "aRetenir": [
