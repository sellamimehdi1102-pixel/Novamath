    {
      "id": "equation-reduite-dune-droite",
      "title": "L'équation réduite",
      "intro": "Dans cette leçon, tu vas apprendre une autre façon d'écrire l'équation d'une droite.",
      "objectif": "À la fin de ce cours, tu sauras utiliser la forme $y = mx + p$.",
      "definition": "L'équation réduite d'une droite s'écrit $y = mx + p$. Le nombre $m$ est le coefficient directeur (la pente). Le nombre $p$ est l'ordonnée à l'origine.",
      "reglesImportantes": [
        "$m$ indique si la droite monte ($m>0$) ou descend ($m<0$).",
        "$p$ est la valeur de $y$ quand $x = 0$.",
        "Les droites verticales n'ont pas d'équation réduite (elles s'écrivent $x = k$)."
      ],
      "methode": {
        "titre": "Comment passer à la forme réduite",
        "etapes": [
          {
            "icone": "sliders",
            "couleur": "blue",
            "texte": "Isole $y$ dans l'équation cartésienne."
          },
          {
            "icone": "target",
            "couleur": "purple",
            "texte": "Identifie le coefficient devant $x$ (c'est $m$)."
          },
          {
            "icone": "check",
            "couleur": "green",
            "texte": "Identifie le nombre tout seul (c'est $p$)."
          }
        ],
        "etapesParNiveau": {
          "normal": [
            {
              "icone": "sliders",
              "couleur": "blue",
              "texte": "Isole $y$ dans l'équation cartésienne."
            },
            {
              "icone": "target",
              "couleur": "purple",
              "texte": "Identifie le coefficient devant $x$ (c'est $m$)."
            },
            {
              "icone": "check",
              "couleur": "green",
              "texte": "Identifie le nombre tout seul (c'est $p$)."
            }
          ],
          "debutant": [],
          "rapide": []
        }
      },
      "exemples": [
        {
          "titre": "Exemple 1",
          "enonce": "Mets $2x+3y-6=0$ sous forme réduite.",
          "calcul": [
            {
              "expr": "3y = -2x+6",
              "texte": "On isole le terme avec $y$."
            },
            {
              "expr": "y = -\\dfrac{2}{3}x + 2",
              "texte": "On divise tout par 3."
            }
          ],
          "reponse": "$m=-\\dfrac{2}{3}$, $p=2$",
          "id": "equation-reduite-dune-droite-exemple-1",
          "difficulte": "moyen"
        }
      ],
      "erreursFrequentes": [
        "Oublier de diviser TOUS les termes par le même nombre.",
        "Confondre $m$ et $p$ dans la formule."
      ],
      "astuce": "$p$ est toujours le nombre \"tout seul\", sans le $x$ à côté.",
      "aRetenir": [
        "$y=mx+p$",
        "$m$ = pente, $p$ = valeur de $y$ quand $x=0$"
