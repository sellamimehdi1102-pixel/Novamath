    {
      "id": "coefficient-directeur-dune-droite",
      "title": "Calculer un coefficient directeur",
      "intro": "Dans cette leçon, tu vas apprendre à calculer la pente d'une droite.",
      "objectif": "À la fin de ce cours, tu sauras calculer $m$ à partir de deux points.",
      "definition": "Le coefficient directeur mesure l'inclinaison d'une droite. On peut le calculer avec les coordonnées de deux points de la droite.",
      "reglesImportantes": [
        "$m = \\dfrac{y_B - y_A}{x_B - x_A}$",
        "$m$ mesure combien $y$ augmente quand $x$ augmente de 1.",
        "Cette formule marche pour deux points quelconques de la droite."
      ],
      "methode": {
        "titre": "Comment calculer un coefficient directeur",
        "etapes": [
          {
            "icone": "target",
            "couleur": "blue",
            "texte": "Repère les coordonnées de deux points de la droite."
          },
          {
            "icone": "sliders",
            "couleur": "purple",
            "texte": "Calcule la différence des $y$, puis la différence des $x$."
          },
          {
            "icone": "check",
            "couleur": "green",
            "texte": "Divise le premier résultat par le second."
          }
        ],
        "etapesParNiveau": {
          "normal": [
            {
              "icone": "target",
              "couleur": "blue",
              "texte": "Repère les coordonnées de deux points de la droite."
            },
            {
              "icone": "sliders",
              "couleur": "purple",
              "texte": "Calcule la différence des $y$, puis la différence des $x$."
            },
            {
              "icone": "check",
              "couleur": "green",
              "texte": "Divise le premier résultat par le second."
            }
          ],
          "debutant": [],
          "rapide": []
        }
      },
      "exemples": [
        {
          "titre": "Exemple 1",
          "enonce": "$A(1\\,;3)$, $B(4\\,;9)$. Calcule le coefficient directeur.",
          "calcul": [
            {
              "expr": "m = \\dfrac{9-3}{4-1}",
              "texte": "On applique la formule."
            },
            {
              "expr": "m = \\dfrac{6}{3} = 2",
              "texte": "On simplifie."
            }
          ],
          "reponse": "$m = 2$",
          "id": "coefficient-directeur-dune-droite-exemple-1",
          "difficulte": "moyen"
        }
      ],
      "erreursFrequentes": [
        "Inverser l'ordre : il faut toujours $y_B - y_A$ sur $x_B - x_A$, dans le même ordre.",
        "Diviser par zéro si les deux points ont le même $x$ (droite verticale)."
      ],
      "astuce": "$m=2$ veut dire : \"$y$ monte de 2 à chaque fois que $x$ avance de 1\".",
      "aRetenir": [
        "$m=\\dfrac{y_B-y_A}{x_B-x_A}$"
      ],
