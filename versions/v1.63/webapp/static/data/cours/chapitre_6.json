      "id": "equation-cartesienne-dune-droite",
      "title": "L'équation cartésienne",
      "intro": "Dans cette leçon, tu vas apprendre à écrire l'équation d'une droite.",
      "objectif": "À la fin de ce cours, tu sauras trouver l'équation cartésienne d'une droite.",
      "definition": "Toute droite du plan a une équation de la forme $ax + by + c = 0$.",
      "reglesImportantes": [
        "Un vecteur directeur associé à cette équation est $(-b\\,;a)$.",
        "Le point $A$ de la droite vérifie l'équation.",
        "On trouve l'équation grâce à la colinéarité."
      ],
      "methode": {
        "titre": "Comment trouver l'équation d'une droite",
        "etapes": [
          {
            "icone": "target",
            "couleur": "blue",
            "texte": "Note un point connu et un vecteur directeur de la droite."
          },
          {
            "icone": "sliders",
            "couleur": "purple",
            "texte": "Écris la condition de colinéarité, puis développe."
          },
          {
            "icone": "check",
            "couleur": "green",
            "texte": "Range l'équation sous la forme $ax+by+c=0$."
          }
        ],
        "etapesParNiveau": {
          "normal": [
            {
              "icone": "target",
              "couleur": "blue",
              "texte": "Note un point connu et un vecteur directeur de la droite."
            },
            {
              "icone": "sliders",
              "couleur": "purple",
              "texte": "Écris la condition de colinéarité, puis développe."
            },
            {
              "icone": "check",
              "couleur": "green",
              "texte": "Range l'équation sous la forme $ax+by+c=0$."
            }
          ],
          "debutant": [],
          "rapide": []
        }
      },
      "exemples": [
        {
          "titre": "Exemple 1",
          "enonce": "Droite passant par $A(1\\,;2)$, vecteur directeur $\\vec{u}(3\\,;-1)$.",
          "calcul": [
            {
              "expr": "3(y-2) - (-1)(x-1) = 0",
              "texte": "On écrit la condition de colinéarité."
            },
            {
              "expr": "3y-6+x-1=0",
              "texte": "On développe."
            },
            {
              "expr": "x+3y-7=0",
              "texte": "On simplifie."
            }
          ],
          "reponse": "$x+3y-7=0$",
          "id": "equation-cartesienne-dune-droite-exemple-1",
          "difficulte": "moyen"
        }
      ],
      "erreursFrequentes": [
        "Se tromper de signe en développant.",
        "Oublier de tout simplifier à la fin."
      ],
      "astuce": "Vérifie ton équation en remplaçant $x$ et $y$ par les coordonnées du point de départ : ça doit donner 0.",
      "aRetenir": [
        "$ax+by+c=0$",
        "Vecteur directeur associé : $(-b\\,;a)$"
